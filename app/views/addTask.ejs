<%- include('partials/header') %>
<div class="glass-card" style="max-width: 600px; margin: 0 auto;">
    <h2 style="margin-bottom: 1.5rem;">Add New Task</h2>
    <form action="/tasks/add" method="POST">
        <div class="form-group">
            <label for="title">Title</label>
            <input type="text" id="title" name="title" required placeholder="What needs to be done?">
        </div>
        <div class="form-group">
            <label for="description">Description</label>
            <textarea id="description" name="description" rows="3" placeholder="Additional details..."></textarea>
        </div>
        <div class="form-group">
            <label for="dueDate">Due Date</label>
            <input type="date" id="dueDate" name="dueDate">
        </div>
        <div class="form-group">
            <label for="priority">Priority</label>
            <select id="priority" name="priority">
                <option value="low">Low</option>
                <option value="medium" selected>Medium</option>
                <option value="high">High</option>
            </select>
        </div>
        <div style="display: flex; gap: 1rem; margin-top: 2rem;">
            <a href="/tasks/dashboard" class="btn" style="background: rgba(255,255,255,0.1); color: white; flex: 1;">Cancel</a>
            <button type="submit" class="btn btn-primary" style="flex: 2;">Save Task</button>
        </div>
    </form>
</div>
<%- include('partials/footer') %>
