<%- include('partials/header') %>
<div class="card" style="max-width: 450px; margin: 2rem auto;">
    <div style="text-align: center; margin-bottom: 2rem;">
        <div style="width: 60px; height: 60px; background: var(--secondary); border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0 auto 1rem; font-size: 1.5rem; color: var(--primary);">
            <i class="fa-solid fa-user-plus"></i>
        </div>
        <h2>Create Account</h2>
        <p style="color: var(--text-muted); margin-top: 0.5rem;">Join TaskMaster and organize your life.</p>
    </div>

    <% if (typeof error !== 'undefined' && error) { %>
        <div class="alert"><i class="fa-solid fa-circle-exclamation"></i> <%= error %></div>
    <% } %>

    <form action="/register" method="POST">
        <div class="form-group">
            <label for="name">Full Name</label>
            <input type="text" id="name" name="name" required placeholder="John Doe">
        </div>
        <div class="form-group">
            <label for="email">Email Address</label>
            <input type="email" id="email" name="email" required placeholder="name@company.com">
        </div>
        <div class="form-group">
            <label for="password">Password</label>
            <input type="password" id="password" name="password" required placeholder="••••••••">
        </div>
        <button type="submit" class="btn btn-primary" style="width: 100%; margin-top: 1rem;"><i class="fa-solid fa-user-check"></i> Register Account</button>
    </form>
    
    <p style="text-align: center; margin-top: 2rem; font-size: 0.95rem; color: var(--text-muted);">
        Already have an account? <a href="/login" style="color: var(--primary); font-weight: 600; text-decoration: none;">Sign in here</a>
    </p>
</div>
<%- include('partials/footer') %>
