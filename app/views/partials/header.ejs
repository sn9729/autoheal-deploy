<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>TaskMaster</title>
    <meta name="description" content="A professional, cloud-native task management application.">
    <!-- FontAwesome for Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <nav>
        <h1><a href="/"><i class="fa-solid fa-layer-group"></i> TaskMaster</a></h1>
        <ul>
            <% if (typeof userId !== 'undefined' && userId) { %>
                <li><a href="/tasks/dashboard"><i class="fa-solid fa-table-columns"></i> Dashboard</a></li>
                <% if (typeof user !== 'undefined' && user) { %>
                    <li>
                        <div class="user-profile">
                            <i class="fa-solid fa-circle-user"></i>
                            <%= user.name %>
                        </div>
                    </li>
                <% } %>
                <li><a href="/logout"><i class="fa-solid fa-arrow-right-from-bracket"></i> Logout</a></li>
            <% } else { %>
                <li><a href="/login"><i class="fa-solid fa-right-to-bracket"></i> Login</a></li>
                <li><a href="/register" class="btn btn-primary btn-small" style="color: #000;"><i class="fa-solid fa-user-plus"></i> Register</a></li>
            <% } %>
        </ul>
    </nav>
    <main class="container">
