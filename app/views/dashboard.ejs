<%- include('partials/header') %>
<div class="dashboard-header">
    <div>
        <h2>Your Tasks</h2>
        <p style="color: var(--text-muted); margin-top: 0.25rem;">Manage and organize your daily activities.</p>
    </div>
    <a href="/tasks/add" class="btn btn-primary"><i class="fa-solid fa-plus"></i> New Task</a>
</div>

<% if (tasks.length === 0) { %>
    <div class="empty-state">
        <i class="fa-solid fa-clipboard-list"></i>
        <h3>No tasks found</h3>
        <p style="margin-bottom: 1.5rem;">You haven't created any tasks yet. Get started by creating one!</p>
        <a href="/tasks/add" class="btn btn-primary"><i class="fa-solid fa-plus"></i> Create your first task</a>
    </div>
<% } else { %>
    <div class="task-grid">
        <% tasks.forEach(task => { %>
            <div class="task-item <%= task.completed ? 'completed' : '' %> priority-<%= task.priority %>">
                <div class="task-header">
                    <div>
                        <div class="task-title"><%= task.title %></div>
                        <div class="task-meta">
                            <% if (task.dueDate) { %>
                                <span><i class="fa-regular fa-calendar"></i> <%= new Date(task.dueDate).toLocaleDateString() %></span>
                            <% } else { %>
                                <span><i class="fa-regular fa-calendar-xmark"></i> No due date</span>
                            <% } %>
                        </div>
                    </div>
                    <span class="badge badge-<%= task.priority %>"><%= task.priority %></span>
                </div>
                
                <% if (task.description) { %>
                    <div class="task-desc"><%= task.description %></div>
                <% } else { %>
                    <div class="task-desc" style="font-style: italic; opacity: 0.5;">No description provided.</div>
                <% } %>
                
                <div class="task-actions">
                    <form action="/tasks/toggle/<%= task._id %>" method="POST" style="flex: 1;">
                        <button type="submit" class="btn btn-small <%= task.completed ? 'btn-outline' : 'btn-success' %>" style="width: 100%;">
                            <i class="fa-solid <%= task.completed ? 'fa-rotate-left' : 'fa-check' %>"></i> <%= task.completed ? 'Undo' : 'Complete' %>
                        </button>
                    </form>
                    <a href="/tasks/edit/<%= task._id %>" class="btn btn-outline btn-small" title="Edit"><i class="fa-solid fa-pen"></i></a>
                    <form action="/tasks/delete/<%= task._id %>" method="POST" onsubmit="return confirm('Are you sure you want to delete this task?');">
                        <button type="submit" class="btn btn-danger btn-small" title="Delete"><i class="fa-solid fa-trash"></i></button>
                    </form>
                </div>
            </div>
        <% }) %>
    </div>
<% } %>
<%- include('partials/footer') %>
